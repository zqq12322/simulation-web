# Copy to .env.local for local overrides (gitignored).
# Vite only exposes variables prefixed with VITE_ to client code.
#
# Base URL of the FastAPI backend. Omit it in local dev to fall back to
# http://localhost:8000. In production point it at your deployed API.
VITE_API_URL=http://localhost:8000

# Optional: Supabase Storage for uploaded geometries (leave empty to disable)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
